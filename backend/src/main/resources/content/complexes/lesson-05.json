            },
            {
              "id": "b",
              "text": "$\\pi$"
            },
            {
              "id": "c",
              "text": "$\\dfrac{\\pi}{2}$"
            },
            {
              "id": "d",
              "text": "$-\\dfrac{\\pi}{2}$"
            }
          ]
        },
        "answer": {
          "correct": [
            "b"
          ],
          "feedback": {
            "a": "$0$ est un argument de $1$, pas de $-1$.",
            "c": "$\\dfrac{\\pi}{2}$ est un argument de $i$.",
            "d": "$-\\dfrac{\\pi}{2}$ est un argument de $-i$."
          }
        },
        "solution": "$-1 = 1\\times(\\cos\\pi + i\\sin\\pi)$ donc $\\arg(-1) \\equiv \\pi \\;[2\\pi]$.",
        "hint": "Placez $-1$ sur l’axe des abscisses."
      }
    },
