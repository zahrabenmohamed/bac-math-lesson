            "d": "$-i = e^{-i\\pi/2}$."
          }
        },
        "solution": "$e^{i\\pi} = \\cos\\pi + i\\sin\\pi = -1$.",
        "hint": "Utilisez $e^{i\\theta} = \\cos\\theta + i\\sin\\theta$."
      }
    },
