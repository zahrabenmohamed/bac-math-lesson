DB_NAME=complexes
DB_USER=complexes
DB_PASSWORD=change-me
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Only needed if the frontend is served from another origin than the nginx proxy
CORS_ORIGINS=http://localhost:5173
# Port where the app is published by docker compose
FRONTEND_PORT=8081
